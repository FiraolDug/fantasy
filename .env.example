# --- Database ---
DATABASE_URL=postgresql+psycopg2://fpl_user:change_me@localhost:5432/fpl_platform

# --- Security ---
SECRET_KEY=change_this_to_a_long_random_string
ADMIN_SESSION_SECRET=change_this_too_a_different_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Bootstrap admin (created on first init_db run) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_strong_password

# --- Manual deposit destinations (MVP / manual verification) ---
TELEBIRR_RECEIVER_NAME=Platform Owner
TELEBIRR_RECEIVER_NUMBER=0961242949
CBE_RECEIVER_NAME=Platform Owner
CBE_ACCOUNT_NUMBER=1000477935471

# --- MVP / test-mode flags ---
# In production, set this to true so a transaction_id cannot be reused across deposits.
ENFORCE_UNIQUE_DEPOSIT_TXN_ID=false
# In production, set this to false. When true, staging/test data is allowed and
# real-money payout paths are blocked at the service layer.
PLATFORM_LIVE=false

# --- Telegram ---
BOT_TOKEN=123456:your-telegram-bot-token
BOT_INTERNAL_SECRET=change_this_shared_secret_used_only_by_the_bot
TELEGRAM_WEBHOOK_SECRET=generate_a_random_secret_using_letters_digits_underscore_or_hyphen
MINI_APP_URL=https://your-domain.example.com/miniapp
# On Render: https://<your-service-name>.onrender.com — set this AFTER
# your first deploy once you know the assigned URL, then redeploy.
PUBLIC_BASE_URL=
BACKEND_INTERNAL_URL=
